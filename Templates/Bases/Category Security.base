filters:
  and:
    - file.ext == "md"
    - (file.inFolder("Projects") || file.inFolder("Knowledge") || file.inFolder("Categories") || file.inFolder("Daily Notes"))
    - file.hasLink("Categories/Security") && type != "category"
views:
  - type: table
    name: Security
    order:
      - file.name
      - type
      - status
      - updated_at
    sort:
      - property: updated_at
        direction: DESC
